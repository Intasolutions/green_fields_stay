SECRET_KEY=change-me-to-a-random-secret-key
# Leave False on any server. Set True only for local development.
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# True for hosted databases (e.g. Neon). Set False for a PostgreSQL on the
# same server, which normally runs without SSL.
DATABASE_SSL_REQUIRE=True

# Origins allowed to call the API from a browser (the frontend URL):
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Public HTTPS origin(s) the Django /admin login is served from:
CSRF_TRUSTED_ORIGINS=https://your-api-host.example.com
